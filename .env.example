# Copy to .env.local. Names only; RUNBOOK.md explains each one and where it is set.
# The catalog needs none of them. Accounts need DATABASE_URL and BETTER_AUTH_SECRET.

# Raises the GitHub API limit for repository stats. No scopes needed.
GITHUB_TOKEN=

# Postgres (Neon). Never copy production values here.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs sessions and email links: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Account emails through Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Sign-up stays invite-only unless ACCOUNTS_OPEN=true.
ACCOUNTS_OPEN=false
ACCOUNTS_ALLOWLIST=
# Shows the header's "Sign in" link; change it together with ACCOUNTS_OPEN.
NEXT_PUBLIC_ACCOUNTS_OPEN=false
# Comma-separated user ids that may moderate at /dashboard/admin.
ADMIN_USER_IDS=

# GitHub sign-in, from an OAuth app whose callback is http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Lets the daily cleanup (/api/cron/cleanup) run: Vercel Cron sends it as a bearer token.
CRON_SECRET=

# Upstash Redis for the rate limits of Server Actions. Without them, development allows every request.
KV_REST_API_URL=
KV_REST_API_TOKEN=
